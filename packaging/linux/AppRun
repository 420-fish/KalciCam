#!/bin/sh
# AppImage entry point.
HERE="$(dirname "$(readlink -f "$0")")"
# Remember the user's own library path; KalciCam restores it for programs it launches.
export KALCICAM_LD_ORIG="${LD_LIBRARY_PATH:-}"
export LD_LIBRARY_PATH="$HERE/usr/lib/kalcicam/_internal${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/lib/kalcicam/kalcicam" "$@"
